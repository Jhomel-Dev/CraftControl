{
  "productName": "CraftControl-Agent",
  "version": "2.9.1",
  "identifier": "com.craftcontrol.agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CraftControl Agent",
        "width": 500,
        "height": 400,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://minecraft-server-pl80.onrender.com/api/agent/latest-release/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjlBMDYxRjNBRDVERDEKUldUUlhhM3pZYUJwWFhJbkpObDFydldTRDVHNk1yM3FYQU5paWx0R3ZxckJmek03aENnQVp5ZSsK"
    }
  }
}
